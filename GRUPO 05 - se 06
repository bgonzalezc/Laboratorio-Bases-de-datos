CREATE DATABASE CursosEstudiante;
USE CursosEstudiante;

-- 1. TABLA CURSO
CREATE TABLE Curso (
    id_curso INT PRIMARY KEY,
    nombre VARCHAR(100),
    codigo VARCHAR(20),
    semestre INT
);


-- 2. TABLA CURSOSESTUDIANTE
-- Representa a los estudiantes

CREATE TABLE CursosEstudiante (
    id_estudiante INT PRIMARY KEY,
    nombre VARCHAR(100),
    correo VARCHAR(100),
    carrera VARCHAR(100)
);


-- 3. TABLA MATRICULA
-- Relaciona estudiante con curso

CREATE TABLE Matricula (
    id_matricula INT PRIMARY KEY,
    id_estudiante INT,
    id_curso INT,
    fecha_matricula DATE,

    FOREIGN KEY (id_estudiante)
        REFERENCES CursosEstudiante(id_estudiante),

    FOREIGN KEY (id_curso)
        REFERENCES Curso(id_curso)
);



