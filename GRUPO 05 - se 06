-- CONSULTA 1
-- MOSTRAR ESTUDIANTES Y SUS CURSOS

SELECT
    CursosEstudiante.nombre,
    Curso.nombre
FROM CursosEstudiante
JOIN Matricula
    ON CursosEstudiante.id_estudiante = Matricula.id_estudiante
JOIN Curso
    ON Matricula.id_curso = Curso.id_curso;



-- CONSULTA 2
-- CURSOS DE BENJAMIN

SELECT
    CursosEstudiante.nombre,
    Curso.nombre,
    Matricula.fecha_matricula
FROM CursosEstudiante
JOIN Matricula
    ON CursosEstudiante.id_estudiante = Matricula.id_estudiante
JOIN Curso
    ON Matricula.id_curso = Curso.id_curso
WHERE CursosEstudiante.nombre = 'Benjamin Gonzalez';



-- CONSULTA 3
-- ESTUDIANTES MATRICULADOS EN BASES DE DATOS

SELECT
    CursosEstudiante.nombre,
    Curso.nombre
FROM CursosEstudiante
JOIN Matricula
    ON CursosEstudiante.id_estudiante = Matricula.id_estudiante
JOIN Curso
    ON Matricula.id_curso = Curso.id_curso
WHERE Curso.nombre = 'Bases de Datos';


-- CONSULTA 4
-- ORDENAR ESTUDIANTES ALFABETICAMENTE

SELECT
    CursosEstudiante.nombre,
    Curso.nombre
FROM CursosEstudiante
JOIN Matricula
    ON CursosEstudiante.id_estudiante = Matricula.id_estudiante
JOIN Curso
    ON Matricula.id_curso = Curso.id_curso
ORDER BY CursosEstudiante.nombre;



-- CONSULTA 5
-- BUSCAR CURSOS QUE CONTENGAN "Datos"

SELECT
    id_curso,
    nombre,
    codigo
FROM Curso
WHERE nombre LIKE '%Datos%';



-- CONSULTA 6
-- CURSOS ENTRE SEMESTRE 5 Y 6


SELECT
    id_curso,
    nombre,
    semestre
FROM Curso
WHERE semestre BETWEEN 5 AND 6;



